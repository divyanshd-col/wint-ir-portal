{
  "functions": {
    "app/api/cron/generate-scorecards/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/generate-pcg-scorecards/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/process-pcg-evaluations/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/generate-kb-suggestions/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/email-batch-eval/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-logs",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-pending-scores",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-pcg-evaluations",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/generate-scorecards",
      "schedule": "30 2 * * 1"
    },
    {
      "path": "/api/cron/generate-pcg-scorecards",
      "schedule": "30 2 * * 1"
    },
    {
      "path": "/api/cron/generate-kb-suggestions",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/email-batch-eval",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/email-cred-reminder",
      "schedule": "0 9 1 * *"
    }
  ]
}
